{
  "openapi": "3.1.0",
  "info": {
    "title": "SurveyExchange API",
    "description": "Credit-based survey exchange platform. Authenticate via POST /api/auth/login, then use the returned token as a Bearer token.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Analytics",
      "description": "Aggregated survey insights and raw response data — owner only"
    },
    {
      "name": "Credits",
      "description": "Credit balance, transaction history, and purchases"
    },
    {
      "name": "Surveys",
      "description": "Create and browse surveys, submit responses, and boost"
    },
    {
      "name": "Authentication",
      "description": "Register and log in to obtain a JWT access token"
    },
    {
      "name": "Users",
      "description": "Authenticated user profile"
    }
  ],
  "paths": {
    "/api/surveys": {
      "post": {
        "tags": [
          "Surveys"
        ],
        "summary": "Create a survey",
        "description": "Creates a new survey with the provided questions. The survey's credit value is automatically calculated from question types.",
        "operationId": "createSurvey",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSurveyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Survey created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SurveyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/surveys/{id}/respond": {
      "post": {
        "tags": [
          "Surveys"
        ],
        "summary": "Submit a response to a survey",
        "description": "Saves the user's answers and atomically awards +1 credit. A user cannot respond to their own survey or respond more than once.",
        "operationId": "submitResponse",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Survey UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitResponseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Response submitted and credit awarded"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          },
          "403": {
            "description": "Cannot respond to own survey",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Survey not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Already responded to this survey",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/surveys/{id}/boost": {
      "post": {
        "tags": [
          "Surveys"
        ],
        "summary": "Boost a survey",
        "description": "Deducts 5 credits from the owner and promotes the survey to the top of the feed for 24 hours. Only the survey owner can boost their own survey.",
        "operationId": "boostSurvey",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Survey UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Survey boosted"
          },
          "401": {
            "description": "Missing or invalid JWT token"
          },
          "403": {
            "description": "Not the survey owner or insufficient credits",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Survey not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/credits/purchase": {
      "post": {
        "tags": [
          "Credits"
        ],
        "summary": "Purchase credits",
        "description": "Simulates a credit purchase (mock payment — always succeeds in v1). Valid package sizes: 10, 25, 50, 100.",
        "operationId": "purchaseCredits",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Credits added",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PurchaseResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid package size",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user",
        "description": "Creates a new account and awards a 10-credit signup bonus. Returns a JWT token on success.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (missing/invalid fields)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in",
        "description": "Authenticates with email and password. Returns a JWT token valid for 24 hours.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get current user profile",
        "description": "Returns the authenticated user's name, email, and current credit balance.",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Profile returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UserSummaryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/surveys/{id}": {
      "get": {
        "tags": [
          "Surveys"
        ],
        "summary": "Get survey by ID",
        "description": "Returns full survey details including all questions.",
        "operationId": "getSurveyById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Survey UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Survey returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SurveyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          },
          "404": {
            "description": "Survey not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/surveys/{id}/analytics": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get survey analytics",
        "description": "Returns aggregated metrics and per-question distributions for the survey. Choice-type questions (MULTIPLE_CHOICE, CHECKBOX, RATING, YES_NO) return option counts and percentages; text questions (SHORT_TEXT, LONG_TEXT) return the raw response list. Only the survey owner may call this endpoint.",
        "operationId": "getAnalytics",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Survey UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Analytics returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/SurveyAnalyticsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          },
          "403": {
            "description": "Not the survey owner",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Survey not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/surveys/{id}/analytics/responses": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get raw paginated responses",
        "description": "Returns paginated response rows showing each respondent's answers per question. User identity is never exposed. Only the survey owner may call this endpoint.",
        "operationId": "getRawResponses",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Survey UUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page number",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            },
            "example": 0
          },
          {
            "name": "size",
            "in": "query",
            "description": "Page size (max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            },
            "example": 20
          }
        ],
        "responses": {
          "200": {
            "description": "Responses returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseResponseRowDTO"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          },
          "403": {
            "description": "Not the survey owner",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Survey not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/surveys/mine": {
      "get": {
        "tags": [
          "Surveys"
        ],
        "summary": "Get my surveys",
        "description": "Returns all surveys created by the authenticated user, ordered by creation date descending.",
        "operationId": "getMySurveys",
        "responses": {
          "200": {
            "description": "List returned",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SurveySummaryResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/surveys/feed": {
      "get": {
        "tags": [
          "Surveys"
        ],
        "summary": "Get survey feed",
        "description": "Returns a paginated list of surveys the authenticated user has not created and has not yet answered. Boosted surveys appear first, then most recent.",
        "operationId": "getFeed",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page number",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            },
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "Feed returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseSurveySummaryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/credits/history": {
      "get": {
        "tags": [
          "Credits"
        ],
        "summary": "Get credit transaction history",
        "description": "Returns the authenticated user's paginated credit ledger, sorted by most recent first.",
        "operationId": "getCreditHistory",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page number",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            },
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "History returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseCreditTransactionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/credits/balance": {
      "get": {
        "tags": [
          "Credits"
        ],
        "summary": "Get credit balance",
        "description": "Returns the authenticated user's current credit balance.",
        "operationId": "getCreditBalance",
        "responses": {
          "200": {
            "description": "Balance returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CreditBalanceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid JWT token"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSurveyRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "estimatedTime": {
            "type": "integer",
            "format": "int32"
          },
          "targetResponses": {
            "type": "integer",
            "format": "int32"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionRequest"
            },
            "minItems": 1
          }
        },
        "required": [
          "questions",
          "title"
        ]
      },
      "QuestionRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "questionType": {
            "type": "string",
            "enum": [
              "MULTIPLE_CHOICE",
              "CHECKBOX",
              "SHORT_TEXT",
              "RATING",
              "YES_NO",
              "LONG_TEXT"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          },
          "orderIndex": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "questionType",
          "text"
        ]
      },
      "QuestionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "questionType": {
            "type": "string",
            "enum": [
              "MULTIPLE_CHOICE",
              "CHECKBOX",
              "SHORT_TEXT",
              "RATING",
              "YES_NO",
              "LONG_TEXT"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          },
          "orderIndex": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SurveyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "estimatedTime": {
            "type": "integer",
            "format": "int32"
          },
          "targetResponses": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "boostExpiry": {
            "type": "string",
            "format": "date-time"
          },
          "boosted": {
            "type": "boolean"
          },
          "creditValue": {
            "type": "integer",
            "format": "int32"
          },
          "owner": {
            "$ref": "#/components/schemas/UserSummaryResponse"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionResponse"
            }
          }
        }
      },
      "UserSummaryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "creditBalance": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "AnswerRequest": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "format": "uuid"
          },
          "answerText": {
            "type": "string"
          },
          "selectedOptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "questionId"
        ]
      },
      "SubmitResponseRequest": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerRequest"
            },
            "minItems": 1
          }
        },
        "required": [
          "answers"
        ]
      },
      "PurchaseRequest": {
        "type": "object",
        "properties": {
          "package": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "package"
        ]
      },
      "CreditTransactionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "type": "string",
            "enum": [
              "SIGNUP_BONUS",
              "SURVEY_REWARD",
              "BOOST_SPEND",
              "PURCHASE"
            ]
          },
          "description": {
            "type": "string"
          },
          "referenceId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PurchaseResponse": {
        "type": "object",
        "properties": {
          "creditsAdded": {
            "type": "integer",
            "format": "int32"
          },
          "newBalance": {
            "type": "integer",
            "format": "int32"
          },
          "transaction": {
            "$ref": "#/components/schemas/CreditTransactionResponse"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "maxLength": 2147483647,
            "minLength": 8
          },
          "institution": {
            "type": "string"
          },
